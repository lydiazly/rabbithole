#!/usr/bin/env bash
#
# Launcher for the games in this repo.
#
# Every game is a self-contained uv project in its own subdirectory, so this
# discovers them rather than listing them: drop in a new subdirectory with a
# pyproject.toml and it shows up here with no edit.

# SC2250 wants ${braces} on every expansion: an opt-in style rule with no
# behavioural difference, declined deliberately so that `shellcheck -o all` stays
# clean and the decision is recorded rather than rediscovered. A file-level
# directive has to precede the first command, `set` included.
# shellcheck disable=SC2250

set -euo pipefail

# Walk to the real script before looking around, because the games are found
# relative to where this file lives. Plain `dirname $0` breaks the obvious way
# to make this runnable from anywhere -- a symlink into ~/bin -- by landing in
# the directory of the link rather than the repository.
#
# readlink without -f, in a loop, because -f is GNU-only; the loop also handles
# a chain of links and link targets written relative to their own directory.
die() {
    printf '%s\n' "$*" >&2
    exit 1
}

script=${BASH_SOURCE[0]}
while [[ -L $script ]]; do
    target=$(readlink "$script")
    if [[ $target == /* ]]; then
        script=$target
    else
        script=$(cd -P "$(dirname "$script")" && pwd)/$target
    fi
done
# Resolved in two steps on purpose. Nested, a failure inside the substitution
# yields an empty string, and `cd ""` returns 0 and stays where it is -- so a
# broken resolution would silently run against whatever directory the user
# happened to be in, which is the exact bug the symlink walk above exists to
# prevent. Not even `set -e` catches it, because nothing failed.
root=$(cd -P "$(dirname "$script")" && pwd) ||
    die "Cannot resolve the directory of $script"
cd "$root" || die "Cannot enter $root"

self=$(basename "${BASH_SOURCE[0]}")

command -v uv >/dev/null ||
    die "uv is not installed -- see https://docs.astral.sh/uv/getting-started/installation/"

# A game is any subdirectory holding a pyproject.toml.
games=()
for manifest in */pyproject.toml; do
    [[ -e $manifest ]] || continue # no matches: the glob stayed literal
    games+=("${manifest%/pyproject.toml}")
done
((${#games[@]})) || die "No games here: no subdirectory has a pyproject.toml."

# The one-line summary each project already declares, for the menu.
description() {
    awk '
        /^\[project\]/ { in_project = 1; next }
        /^\[/          { in_project = 0 }
        in_project && /^description[[:space:]]*=/ {
            sub(/^description[[:space:]]*=[[:space:]]*/, "")
            gsub(/^"|"$/, "")
            print
            exit
        }
    ' "$1/pyproject.toml"
}

# What to hand `uv run`. Every game names its own entry point under
# [project.scripts], so this reads it rather than guessing from the file layout.
entry_point() {
    awk '
        /^\[project\.scripts\]/ { in_scripts = 1; next }
        /^\[/                   { in_scripts = 0 }
        in_scripts && /=/ {
            sub(/[[:space:]]*=.*/, "")
            gsub(/["[:space:]]/, "")
            print
            exit
        }
    ' "$1/pyproject.toml"
}

launch() {
    local dir=$1 entry
    entry=$(entry_point "$dir")
    [[ -n $entry ]] || die \
        "Don't know how to start '$dir': its pyproject.toml declares no [project.scripts] entry."
    printf '\n  starting %s\n\n' "$dir"
    cd "$dir"
    # exec so the game owns the terminal, and its exit code becomes ours.
    exec uv run "$entry"
}

usage() {
    printf 'usage: %s [game]\n\nGames:\n' "$self"
    local game blurb
    for game in "${games[@]}"; do
        blurb=$(description "$game")
        printf '  %-14s %s\n' "$game" "$blurb"
    done
}

if (($# > 1)); then
    usage >&2
    exit 2
fi

if (($# == 1)); then
    case $1 in
        -h | --help | -l | --list)
            usage
            exit 0
            ;;
        *) ;; # a game name; matched below
    esac
    for game in "${games[@]}"; do
        if [[ $game == "$1" ]]; then
            launch "$game"
        fi
    done
    printf "No such game: '%s'\n\n" "$1" >&2
    usage >&2
    exit 1
fi

# No argument: pick one interactively.
[[ -t 0 ]] || die "Not a terminal -- name the game instead, e.g. $self ${games[0]}"

printf '\n  rabbithole\n\n'
for i in "${!games[@]}"; do
    blurb=$(description "${games[i]}")
    printf '  %d) %-14s %s\n' "$((i + 1))" "${games[i]}" "$blurb"
done
printf '  q) quit\n\n'

read -rp '  pick: ' choice

case $choice in
    q | Q | '') exit 0 ;;
    *) ;; # a number or a name; matched below
esac

# Accept either the menu number or the name.
if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#games[@]})); then
    launch "${games[choice - 1]}"
fi
for game in "${games[@]}"; do
    if [[ $game == "$choice" ]]; then
        launch "$game"
    fi
done

die "Not one of the choices: '$choice'"
